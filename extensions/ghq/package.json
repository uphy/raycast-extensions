{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "ghq",
  "title": "ghq",
  "description": "Search repositories",
  "icon": "extension-icon.png",
  "author": "uphy",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "search-repositories",
      "title": "Search Repositories",
      "description": "Search repositories managed by ghq",
      "mode": "view",
      "preferences": [
        {
          "name": "query",
          "description": "Query to filter repositories",
          "type": "textfield",
          "required": false,
          "title": "Query",
          "placeholder": "Leave blank to search all repositories"
        }
      ]
    },
    {
      "name": "open-repository",
      "title": "Open Repository",
      "description": "Open the repository",
      "mode": "view",
      "arguments": [
        {
          "name": "path",
          "description": "Path to the repository directory",
          "type": "text",
          "required": true,
          "placeholder": "e.g. /Users/me/ghq/github.com/owner/repo"
        }
      ]
    },
    {
      "name": "clone-repository",
      "title": "Clone Repository",
      "description": "Clone a repository with ghq",
      "mode": "view",
      "arguments": [
        {
          "name": "url",
          "description": "URL of the repository to clone",
          "type": "text",
          "required": true,
          "placeholder": "e.g. https://github.com/xxx/yyy.git"
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "pathEnv",
      "description": "Colon-separated list of directories to search for executables",
      "type": "textfield",
      "required": true,
      "title": "PATH",
      "placeholder": "e.g. /usr/local/bin:/usr/bin:/bin",
      "default": "/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.23",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^10.8.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prepublishOnly": "echo \"\\n\\nIt seems like you are trying to publish the Raycast extension to npm.\\n\\nIf you did intend to publish it to npm, remove the \\`prepublishOnly\\` script and rerun \\`npm publish\\` again.\\nIf you wanted to publish it to the Raycast Store instead, use \\`npm run publish\\` instead.\\n\\n\" && exit 1",
    "publish": "npx @raycast/api@latest publish",
    "typecheck": "tsc --noEmit"
  }
}